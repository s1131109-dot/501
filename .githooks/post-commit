#!/bin/sh
# post-commit hook - 自動更新 README.md 變更記錄
# 當 memory-game.html 被修改時，自動追加 changelog 項目為獨立 commit

LOCK_FILE=".git/CHANGELOG_HOOK_LOCK"

# 鎖定檔案防止遞迴
if [ -f "$LOCK_FILE" ]; then
    exit 0
fi

CHANGED_FILES=$(git diff-tree --no-commit-id -r --name-only HEAD)
echo "$CHANGED_FILES" | grep -q "memory-game.html" || exit 0

touch "$LOCK_FILE"

HASH=$(git log -1 --pretty=format:'%h')
DATE=$(git log -1 --pretty=format:'%ai' | cut -d' ' -f1)
SUBJECT=$(git log -1 --pretty=format:'%s')

# 檢查是否已記錄過該 hash（避免重複 commit）
if [ -f README.md ]; then
    LAST_HASH=$(grep -o "$HASH" README.md 2>/dev/null | tail -1)
    if [ "$LAST_HASH" = "$HASH" ]; then
        rm -f "$LOCK_FILE"
        exit 0
    fi
fi

# 追加 changelog（用 git 原始 hash，commit 完才確定 hash，所以用 %h）
ENTRY="\n### $DATE - $HASH\n- **$SUBJECT**\n"
printf "%b" "$ENTRY" >> README.md

# 以獨立 commit 記錄 changelog 更新
git add README.md
git commit -m "docs(changelog): record commit $HASH"

rm -f "$LOCK_FILE"
echo "[post-commit] README.md changelog updated for $HASH"
